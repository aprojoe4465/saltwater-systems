# Copy to .env.local for local testing. Do not commit real values.
# Booking emails send through Resend.
RESEND_API_KEY=
# Use a sender on a domain verified in Resend. Until saltwatersystems.net is
# added there, a verified Snapper Marine sender can be used temporarily.
RESEND_FROM=Saltwater Systems <bookings@saltwatersystems.net>
# Notification inbox (code also defaults to this address if unset).
# This mailbox is not set up yet — test emails will bounce until it exists.
BOOKING_NOTIFY_TO=jbarnes@saltwatersystems.net
# Optional booking alert webhook. Leave unset until you have a URL and auth value.
# Authorization is sent as the full header value in BOOKING_ALERT_WEBHOOK_AUTH.
BOOKING_ALERT_WEBHOOK_URL=
BOOKING_ALERT_WEBHOOK_AUTH=
